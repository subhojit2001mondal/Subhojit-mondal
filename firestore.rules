rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Customer bookings collection
    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // Customer inquiries collection
    match /customerInquiries/{inquiryId} {
      allow read, write: if true;
    }

    // Legacy/direct photo records
    match /photos/{photoId} {
      allow read, write: if true;
    }

    // Permanent room and common-area gallery photos
    match /galleryPhotos/{photoId} {
      allow read, write: if true;
    }

    // Room pricing rates
    match /roomPricing/{roomId} {
      allow read, write: if true;
    }

    // Editable contact numbers
    match /contactNumbers/{contactId} {
      allow read, write: if true;
    }

    // Editable tourist spots collection
    match /touristSpots/{spotId} {
      allow read, write: if true;
    }
  }
}


